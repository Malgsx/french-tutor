# After you fork: copy this file and add YOUR OpenAI project key.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Demo and avatar customization work with both lines left commented out.
# Live / real-time voice needs both values. The key stays on this computer.
# Never commit .env. Never put a key in VITE_*, renderer code, or a chat.

# LIVE_ENABLED=true
# OPENAI_API_KEY=sk-your-project-key-here
