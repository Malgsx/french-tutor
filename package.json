{
  "name": "miette-french-tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=26.5.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "check": "tsc --noEmit && eslint .",
    "test": "tsx --test tests/*.test.ts",
    "desktop": "npm run build && npm exec --yes --package=node@26.5.0 -- node desktop/start.mjs",
    "desktop:live": "LIVE_ENABLED=true npm run desktop",
    "desktop:pack": "electron-builder --mac dir"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "three": "^0.186.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.0",
    "fflate": "^0.8.3",
    "globals": "^16.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "local.miette.tutor",
    "productName": "Miette",
    "files": [
      "desktop/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Miette uses your microphone only when a parent starts live French practice."
      }
    }
  }
}
